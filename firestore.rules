rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /loto3/{doc} {
      allow read: if request.auth != null
        && request.auth.token.email == "akunh1000@gmail.com";
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
